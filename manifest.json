{
  "manifest_version": 3,
  "name": "EnableUser Accessibility Widget",
  "version": "0.1.13",
  "description": "Scan a single page or crawl same-site links (configurable max URLs and crawl depth) against WCAG 2.1 AA using axe-core. Produces a CSV report.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EnableUser Accessibility Widget"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "downloads",
    "storage",
    "unlimitedStorage",
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
